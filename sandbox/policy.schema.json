{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/schemas/research-policy-v1.json",
  "title": "Axon read-only research policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "allowed_hosts", "allowed_content_types", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "allowed_hosts": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "allowed_content_types": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["text/html", "text/plain", "application/json"]}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["request_bytes", "response_bytes", "redirects", "timeout_seconds", "concurrency", "requests_per_minute"],
      "properties": {
        "request_bytes": {"type": "integer", "minimum": 256, "maximum": 8192},
        "response_bytes": {"type": "integer", "minimum": 1024, "maximum": 5242880},
        "redirects": {"type": "integer", "minimum": 0, "maximum": 3},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 15},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    }
  }
}

