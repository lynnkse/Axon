# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm
RUN groupadd --gid 10003 axon-net && useradd --uid 10003 --gid 10003 --no-create-home axon-net
WORKDIR /opt/axon-net
COPY --chown=root:root topology/net_fixture.py /opt/axon-net/net_fixture.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10003:10003
ENTRYPOINT ["python", "/opt/axon-net/net_fixture.py"]
