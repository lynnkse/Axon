# syntax=docker/dockerfile:1
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends iptables \
 && rm -rf /var/lib/apt/lists/*
COPY --chown=root:root topology/firewall.sh /usr/local/sbin/axon-step6-firewall
ENTRYPOINT ["sh", "/usr/local/sbin/axon-step6-firewall"]
